# Local/test credentials only. Never use these values for a deployed service.
POSTGRES_USER=kinto_admin
POSTGRES_PASSWORD=kinto-local-admin-only
POSTGRES_DB=kinto_test
POSTGRES_PORT=55432
MIGRATION_DATABASE_URL=postgresql://kinto_admin:kinto-local-admin-only@127.0.0.1:55432/kinto_test
DATABASE_URL=postgresql://kinto_app:kinto-local-app-only@127.0.0.1:55432/kinto_test
WORKER_DATABASE_URL=postgresql://kinto_worker:kinto-local-worker-only@127.0.0.1:55432/kinto_test
DISPATCHER_DATABASE_URL=postgresql://kinto_dispatcher:kinto-local-dispatch-only@127.0.0.1:55432/kinto_test
# Dedicated local Redis, never shared with another application. No public binding.
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_PORT=56379
WORKER_QUEUE=kinto-foundation
WORKER_POLL_MS=2000
WORKER_MONITOR_PORT=9464
# Local/CI recovery drill only; must be the container behind the test database URL.
RECOVERY_POSTGRES_CONTAINER=kinto-hr-postgres-1
API_PORT=4000
API_HOST=127.0.0.1
API_URL=http://127.0.0.1:4000
# Authentication stays closed by default. See docs/operations/authentication.md.
AUTH_MODE=disabled
# For an approved synthetic local identity provider only; never copy client secrets into Git.
# NODE_ENV=development
# AUTH_ORIGIN=http://localhost:3000
# OIDC_ISSUER=http://localhost:8080/realms/kinto
# OIDC_CLIENT_ID=kinto-web
# OIDC_CLIENT_SECRET=<secret-from-the-identity-provider>
# OIDC_MFA_PROFILE=none
# Use keycloak-loa2-v1 only with the verified flow in docs/operations/keycloak.md.
# AUTH_REDIS_URL=redis://127.0.0.1:56379/1
# Initial-owner provider delivery is separately disabled by default. It requires
# the reviewed Keycloak MFA profile above and a dedicated server-only client.
# ACCOUNT_PROVISIONING_MODE=disabled
# KEYCLOAK_PROVISIONING_CLIENT_ID=kinto-provisioner
# KEYCLOAK_PROVISIONING_CLIENT_SECRET=<dedicated-service-account-secret>
