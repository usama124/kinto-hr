generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}
model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(160)
  employeeLimit Int @map("employee_limit")
  status String @default("active") @db.VarChar(20)
  billingMode String @default("free") @map("billing_mode") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  employees Employee[]
  auditEvents AuditEvent[]
  outboxEvents OutboxEvent[]
  memberships Membership[]
  @@map("tenants")
}
model Identity {
  id String @id @default(uuid()) @db.Uuid
  issuer String @db.VarChar(512)
  subject String @db.VarChar(255)
  status String @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  memberships Membership[]
  @@unique([issuer, subject])
  @@map("identities")
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  identityId String @map("identity_id") @db.Uuid
  status String @default("active") @db.VarChar(20)
  roles String[]
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  @@unique([tenantId, identityId])
  @@map("memberships")
}
model Employee {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  employeeNumber String @map("employee_number") @db.VarChar(40)
  name String @db.VarChar(160)
  status String @default("draft") @db.VarChar(20)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@map("employees")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(100)
  reason String? @db.VarChar(240)
  resourceId String @map("resource_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
  @@map("audit_events")
}
model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  type String @db.VarChar(100)
  aggregateId String @map("aggregate_id") @db.Uuid
  aggregateVersion Int @map("aggregate_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  delivery JobDelivery?
  receipt ConsumerReceipt?
  @@unique([tenantId, id])
  @@unique([tenantId, aggregateId, aggregateVersion, type])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}
model JobDelivery {
  eventId String @id @map("event_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  status String @default("pending") @db.VarChar(20)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz()
  lastError String? @map("last_error") @db.VarChar(60)
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  event OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, eventId])
  @@map("job_deliveries")
}
model ConsumerReceipt {
  eventId String @id @map("event_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  consumer String @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz()
  event OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, eventId])
  @@map("consumer_receipts")
}
