generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

model Tenant {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String                        @db.VarChar(160)
  employeeLimit                Int                           @map("employee_limit")
  status                       String                        @default("active") @db.VarChar(20)
  billingMode                  String                        @default("free") @map("billing_mode") @db.VarChar(20)
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz()
  employees                    Employee[]
  employeePrivateDetails       EmployeePrivateDetail[]
  compensationAgreements       CompensationAgreement[]
  salaryComponents             SalaryComponent[]
  compensationComponentVersions CompensationComponentVersion[]
  checklistTasks               ChecklistTask[]
  employeeImportBatches        EmployeeImportBatch[]
  employeeImportRows           EmployeeImportRow[]
  employmentPeriods            EmploymentPeriod[]
  employeeAssignments          EmployeeAssignment[]
  auditEvents                  AuditEvent[]
  outboxEvents                 OutboxEvent[]
  memberships                  Membership[]
  provisioningRequest          CompanyProvisioningRequest?
  ownerInvitations             OwnerInvitation[]
  employeeAccountRequests      EmployeeAccountRequest[]
  employeeInvitations          EmployeeInvitation[]
  employeeIdentityLinks        EmployeeIdentityLink[]
  administratorAccountRequests AdministratorAccountRequest[]
  administratorInvitations     AdministratorInvitation[]
  legalEntity                  LegalEntity?
  branches                     Branch[]
  departments                  Department[]
  designations                 Designation[]
  companyPolicyVersions        CompanyPolicyVersion[]
  subscriptions                TenantSubscription[]
  entitlementState             TenantEntitlementState?
  entitlementGrants            EntitlementGrant[]
  entitlementOverrides         EntitlementOverride[]

  @@map("tenants")
}

model Identity {
  id                           String                        @id @default(uuid()) @db.Uuid
  issuer                       String                        @db.VarChar(512)
  subject                      String                        @db.VarChar(255)
  status                       String                        @default("active") @db.VarChar(20)
  createdAt                    DateTime                      @default(now()) @map("created_at") @db.Timestamptz()
  memberships                  Membership[]
  platformOperator             PlatformOperator?
  companyProvisioningRequests  CompanyProvisioningRequest[]
  platformAuditEvents          PlatformAuditEvent[]
  ownerInvitations             OwnerInvitation[]
  employeeAccountRequests      EmployeeAccountRequest[]
  employeeInvitations          EmployeeInvitation[]
  employeeIdentityLinks        EmployeeIdentityLink[]
  administratorAccountRequests AdministratorAccountRequest[]
  administratorInvitations     AdministratorInvitation[]
  createdCompanyPolicies       CompanyPolicyVersion[]        @relation("PolicyCreatedBy")
  publishedCompanyPolicies     CompanyPolicyVersion[]        @relation("PolicyPublishedBy")
  createdEntitlementGrants     EntitlementGrant[]             @relation("GrantCreatedBy")
  revokedEntitlementGrants     EntitlementGrant[]             @relation("GrantRevokedBy")
  createdEntitlementOverrides  EntitlementOverride[]          @relation("OverrideCreatedBy")
  revokedEntitlementOverrides  EntitlementOverride[]          @relation("OverrideRevokedBy")
  updatedEmployeePrivateDetails EmployeePrivateDetail[]         @relation("PrivateDetailsUpdatedBy")
  createdCompensationVersions   CompensationComponentVersion[]   @relation("CompensationVersionCreatedBy")
  assignedChecklistTasks        ChecklistTask[]                   @relation("ChecklistAssignee")
  completedChecklistTasks       ChecklistTask[]                   @relation("ChecklistCompletedBy")
  createdChecklistTasks         ChecklistTask[]                   @relation("ChecklistCreatedBy")
  createdEmployeeImportBatches  EmployeeImportBatch[]              @relation("EmployeeImportCreatedBy")

  @@unique([issuer, subject])
  @@map("identities")
}

model LegalEntity {
  id                 String   @id @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  legalName          String   @map("legal_name") @db.VarChar(160)
  registrationNumber String?  @map("registration_number") @db.VarChar(80)
  taxNumber          String?  @map("tax_number") @db.VarChar(80)
  countryCode        String   @default("PK") @map("country_code") @db.Char(2)
  currencyCode       String   @default("PKR") @map("currency_code") @db.Char(3)
  timeZone           String   @default("Asia/Karachi") @map("time_zone") @db.VarChar(64)
  provinceCode       String   @map("province_code") @db.VarChar(5)
  version            Int      @default(1)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branches           Branch[]

  @@unique([tenantId, id])
  @@map("legal_entities")
}

model Branch {
  id            String      @id @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  legalEntityId String      @map("legal_entity_id") @db.Uuid
  code          String      @db.VarChar(20)
  name          String      @db.VarChar(160)
  provinceCode  String      @map("province_code") @db.VarChar(5)
  status        String      @default("active") @db.VarChar(20)
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legalEntity   LegalEntity @relation(fields: [tenantId, legalEntityId], references: [tenantId, id], onDelete: Restrict)
  employeeAssignments EmployeeAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("branches")
}

model Department {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(160)
  status    String   @default("active") @db.VarChar(20)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeAssignments EmployeeAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("departments")
}

model Designation {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String   @db.VarChar(20)
  name      String   @db.VarChar(160)
  status    String   @default("active") @db.VarChar(20)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeAssignments EmployeeAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("designations")
}

model CompanyPolicyVersion {
  id                    String    @id @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  domain                String    @db.VarChar(50)
  policyVersion         Int       @map("policy_version")
  basedOnVersion        Int       @map("based_on_version")
  status                String    @default("draft") @db.VarChar(20)
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  settings              Json      @db.JsonB
  reason                String    @db.VarChar(240)
  createdByIdentityId   String    @map("created_by_identity_id") @db.Uuid
  publishedByIdentityId String?   @map("published_by_identity_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  publishedAt           DateTime? @map("published_at") @db.Timestamptz()
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy             Identity  @relation("PolicyCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  publishedBy           Identity? @relation("PolicyPublishedBy", fields: [publishedByIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, domain, policyVersion])
  @@index([tenantId, domain, status, effectiveFrom])
  @@map("company_policy_versions")
}

model PlanVersion {
  id            String               @id @db.Uuid
  code          String               @db.VarChar(30)
  planVersion   Int                  @map("plan_version")
  employeeLimit Int                  @map("employee_limit")
  capabilities  Json                 @db.JsonB
  status        String               @default("test_seed") @db.VarChar(20)
  publishedAt   DateTime             @default(now()) @map("published_at") @db.Timestamptz()
  subscriptions TenantSubscription[]

  @@unique([code, planVersion])
  @@map("plan_versions")
}

model TenantSubscription {
  id                  String      @id @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  subscriptionVersion Int         @map("subscription_version")
  planVersionId       String      @map("plan_version_id") @db.Uuid
  billingMode         String      @map("billing_mode") @db.VarChar(20)
  employeeLimit       Int         @map("employee_limit")
  status              String      @default("active") @db.VarChar(20)
  effectiveFrom       DateTime    @default(now()) @map("effective_from") @db.Timestamptz()
  endedAt             DateTime?   @map("ended_at") @db.Timestamptz()
  reason              String      @db.VarChar(240)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersion         PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, subscriptionVersion])
  @@index([tenantId, status, effectiveFrom])
  @@map("tenant_subscriptions")
}

model TenantEntitlementState {
  tenantId  String   @id @map("tenant_id") @db.Uuid
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_entitlement_states")
}

model EntitlementGrant {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  kind                String    @db.VarChar(30)
  employeeLimit       Int?      @map("employee_limit")
  seatDelta           Int?      @map("seat_delta")
  startsAt            DateTime  @map("starts_at") @db.Timestamptz()
  endsAt              DateTime  @map("ends_at") @db.Timestamptz()
  status              String    @default("active") @db.VarChar(20)
  version             Int       @default(1)
  reason              String    @db.VarChar(240)
  createdByIdentityId String    @map("created_by_identity_id") @db.Uuid
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  revokedReason       String?   @map("revoked_reason") @db.VarChar(240)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz()
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy           Identity  @relation("GrantCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  revokedBy           Identity? @relation("GrantRevokedBy", fields: [revokedByIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status, startsAt, endsAt])
  @@map("entitlement_grants")
}

model EntitlementOverride {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  field               String    @db.VarChar(40)
  employeeLimit       Int       @map("employee_limit")
  startsAt            DateTime  @map("starts_at") @db.Timestamptz()
  endsAt              DateTime  @map("ends_at") @db.Timestamptz()
  status              String    @default("active") @db.VarChar(20)
  version             Int       @default(1)
  reason              String    @db.VarChar(240)
  createdByIdentityId String    @map("created_by_identity_id") @db.Uuid
  revokedByIdentityId String?   @map("revoked_by_identity_id") @db.Uuid
  revokedReason       String?   @map("revoked_reason") @db.VarChar(240)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz()
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy           Identity  @relation("OverrideCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  revokedBy           Identity? @relation("OverrideRevokedBy", fields: [revokedByIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, field, status, startsAt, endsAt])
  @@map("entitlement_overrides")
}

model PlatformOperator {
  identityId String   @id @map("identity_id") @db.Uuid
  status     String   @default("active") @db.VarChar(20)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@map("platform_operators")
}

model CompanyProvisioningRequest {
  id                    String           @id @db.Uuid
  requestKey            String           @map("request_key") @db.Uuid
  requestedByIdentityId String           @map("requested_by_identity_id") @db.Uuid
  tenantId              String           @unique @map("tenant_id") @db.Uuid
  initialOwnerEmail     String           @map("initial_owner_email") @db.VarChar(320)
  status                String           @default("pending_identity_provider") @db.VarChar(40)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  requestedBy           Identity         @relation(fields: [requestedByIdentityId], references: [id], onDelete: Restrict)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitation            OwnerInvitation?

  @@unique([requestedByIdentityId, requestKey])
  @@map("company_provisioning_requests")
}

model OwnerInvitation {
  id          String                     @id @db.Uuid
  requestId   String                     @unique @map("request_id") @db.Uuid
  tenantId    String                     @map("tenant_id") @db.Uuid
  identityId  String                     @map("identity_id") @db.Uuid
  status      String                     @default("pending_delivery") @db.VarChar(30)
  expiresAt   DateTime                   @map("expires_at") @db.Timestamptz()
  deliveredAt DateTime?                  @map("delivered_at") @db.Timestamptz()
  acceptedAt  DateTime?                  @map("accepted_at") @db.Timestamptz()
  version     Int                        @default(1)
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  request     CompanyProvisioningRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identity    Identity                   @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, identityId])
  @@index([status, expiresAt])
  @@map("owner_invitations")
}

model PlatformAuditEvent {
  id         String   @id @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  actor      Identity @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("platform_audit_events")
}

model Membership {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  identityId           String                @map("identity_id") @db.Uuid
  status               String                @default("active") @db.VarChar(20)
  roles                String[]
  version              Int                   @default(1)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identity             Identity              @relation(fields: [identityId], references: [id], onDelete: Restrict)
  employeeIdentityLink EmployeeIdentityLink?

  @@unique([tenantId, identityId])
  @@unique([tenantId, id])
  @@map("memberships")
}

model AdministratorAccountRequest {
  id                    String                   @id @db.Uuid
  requestKey            String                   @map("request_key") @db.Uuid
  tenantId              String                   @map("tenant_id") @db.Uuid
  requestedByIdentityId String                   @map("requested_by_identity_id") @db.Uuid
  email                 String                   @db.VarChar(320)
  roles                 String[]
  reason                String                   @db.VarChar(240)
  status                String                   @default("pending_identity_provider") @db.VarChar(40)
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  tenant                Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  requestedBy           Identity                 @relation(fields: [requestedByIdentityId], references: [id], onDelete: Restrict)
  invitation            AdministratorInvitation?

  @@unique([tenantId, requestKey])
  @@unique([tenantId, email])
  @@map("administrator_account_requests")
}

model AdministratorInvitation {
  id          String                      @id @db.Uuid
  requestId   String                      @unique @map("request_id") @db.Uuid
  tenantId    String                      @map("tenant_id") @db.Uuid
  identityId  String                      @map("identity_id") @db.Uuid
  status      String                      @default("pending_delivery") @db.VarChar(30)
  expiresAt   DateTime                    @map("expires_at") @db.Timestamptz()
  deliveredAt DateTime?                   @map("delivered_at") @db.Timestamptz()
  acceptedAt  DateTime?                   @map("accepted_at") @db.Timestamptz()
  version     Int                         @default(1)
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz()
  request     AdministratorAccountRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  tenant      Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identity    Identity                    @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, identityId])
  @@index([status, expiresAt])
  @@map("administrator_invitations")
}

model Employee {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @map("tenant_id") @db.Uuid
  employeeNumber         String                  @map("employee_number") @db.VarChar(40)
  name                   String                  @db.VarChar(160)
  legalName              String?                 @map("legal_name") @db.VarChar(160)
  joiningDate            DateTime?               @map("joining_date") @db.Date
  employmentType         String?                 @map("employment_type") @db.VarChar(30)
  status                 String                  @default("draft") @db.VarChar(20)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  archivedAt             DateTime?               @map("archived_at") @db.Timestamptz()
  archivedByIdentityId   String?                 @map("archived_by_identity_id") @db.Uuid
  archiveReason          String?                 @map("archive_reason") @db.VarChar(240)
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeAccountRequest EmployeeAccountRequest?
  employeeInvitation     EmployeeInvitation?
  employeeIdentityLink   EmployeeIdentityLink?
  employmentPeriods      EmploymentPeriod[]
  assignments            EmployeeAssignment[]    @relation("AssignedEmployee")
  managedAssignments     EmployeeAssignment[]    @relation("AssignmentManager")
  privateDetails         EmployeePrivateDetail?
  compensationAgreement CompensationAgreement?
  checklistTasks         ChecklistTask[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@map("employees")
}

model EmployeePrivateDetail {
  id                    String   @id @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  employeeId            String   @map("employee_id") @db.Uuid
  personalEmail         String?  @map("personal_email") @db.VarChar(320)
  mobilePhone           String?  @map("mobile_phone") @db.VarChar(16)
  residentialAddress    String?  @map("residential_address") @db.VarChar(500)
  emergencyContactName  String?  @map("emergency_contact_name") @db.VarChar(160)
  emergencyContactPhone String?  @map("emergency_contact_phone") @db.VarChar(16)
  cnic                  String?  @db.VarChar(13)
  version               Int      @default(1)
  updatedByIdentityId   String   @map("updated_by_identity_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee              Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  updatedBy             Identity @relation("PrivateDetailsUpdatedBy", fields: [updatedByIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId])
  @@map("employee_private_details")
}

model CompensationAgreement {
  id            String                         @id @db.Uuid
  tenantId      String                         @map("tenant_id") @db.Uuid
  employeeId    String                         @map("employee_id") @db.Uuid
  currencyCode  String                         @default("PKR") @map("currency_code") @db.Char(3)
  version       Int                            @default(1)
  createdAt     DateTime                       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime                       @updatedAt @map("updated_at") @db.Timestamptz()
  tenant        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee      Employee                       @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  components    SalaryComponent[]
  versions      CompensationComponentVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId])
  @@map("compensation_agreements")
}

model SalaryComponent {
  id          String                         @id @db.Uuid
  tenantId    String                         @map("tenant_id") @db.Uuid
  agreementId String                         @map("agreement_id") @db.Uuid
  code        String                         @db.VarChar(30)
  createdAt   DateTime                       @default(now()) @map("created_at") @db.Timestamptz()
  tenant      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agreement   CompensationAgreement          @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Restrict)
  versions    CompensationComponentVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, agreementId, code])
  @@unique([tenantId, agreementId, id])
  @@map("salary_components")
}

model CompensationComponentVersion {
  id                  String                @id @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  agreementId         String                @map("agreement_id") @db.Uuid
  componentId         String                @map("component_id") @db.Uuid
  revision            Int
  name                String                @db.VarChar(100)
  kind                String                @db.VarChar(20)
  monthlyAmount       Decimal               @map("monthly_amount") @db.Decimal(15, 2)
  effectiveFrom       DateTime              @map("effective_from") @db.Date
  effectiveTo         DateTime?             @map("effective_to") @db.Date
  reason              String                @db.VarChar(240)
  createdByIdentityId String                @map("created_by_identity_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agreement           CompensationAgreement @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Restrict)
  component           SalaryComponent       @relation(fields: [tenantId, agreementId, componentId], references: [tenantId, agreementId, id], onDelete: Restrict)
  createdBy           Identity              @relation("CompensationVersionCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, agreementId, revision, componentId])
  @@index([tenantId, agreementId, effectiveFrom])
  @@map("compensation_component_versions")
}

model EmploymentPeriod {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  employeeId       String    @map("employee_id") @db.Uuid
  periodNumber     Int       @map("period_number")
  joiningDate      DateTime  @map("joining_date") @db.Date
  finalWorkingDate DateTime? @map("final_working_date") @db.Date
  terminationScheduledByIdentityId String? @map("termination_scheduled_by_identity_id") @db.Uuid
  terminationReason String? @map("termination_reason") @db.VarChar(240)
  terminationScheduledAt DateTime? @map("termination_scheduled_at") @db.Timestamptz()
  status           String    @default("planned") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee         Employee  @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  assignments      EmployeeAssignment[]
  checklistTasks   ChecklistTask[]

  @@unique([tenantId, id])
  @@unique([tenantId, id, employeeId])
  @@unique([tenantId, employeeId, periodNumber])
  @@index([tenantId, employeeId, status])
  @@map("employment_periods")
}

model ChecklistTask {
  id                    String           @id @db.Uuid
  tenantId              String           @map("tenant_id") @db.Uuid
  employeeId            String           @map("employee_id") @db.Uuid
  employmentPeriodId    String           @map("employment_period_id") @db.Uuid
  lifecycle             String           @db.VarChar(20)
  taskCode              String           @map("task_code") @db.VarChar(50)
  title                 String           @db.VarChar(160)
  assigneeIdentityId    String           @map("assignee_identity_id") @db.Uuid
  dueDate               DateTime         @map("due_date") @db.Date
  status                String           @default("pending") @db.VarChar(20)
  version               Int              @default(1)
  completedAt           DateTime?        @map("completed_at") @db.Timestamptz()
  completedByIdentityId String?          @map("completed_by_identity_id") @db.Uuid
  createdByIdentityId   String           @map("created_by_identity_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee              Employee         @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  employmentPeriod      EmploymentPeriod @relation(fields: [tenantId, employmentPeriodId, employeeId], references: [tenantId, id, employeeId], onDelete: Restrict)
  assignee              Identity         @relation("ChecklistAssignee", fields: [assigneeIdentityId], references: [id], onDelete: Restrict)
  completedBy           Identity?        @relation("ChecklistCompletedBy", fields: [completedByIdentityId], references: [id], onDelete: Restrict)
  createdBy             Identity         @relation("ChecklistCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, employmentPeriodId, taskCode])
  @@index([tenantId, employeeId, status, dueDate])
  @@map("checklist_tasks")
}

model EmployeeImportBatch {
  id                  String              @id @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  fileName            String              @map("file_name") @db.VarChar(120)
  fileDigest          String              @map("file_digest") @db.Char(64)
  requestKey          String              @map("request_key") @db.Uuid
  requestDigest       String              @map("request_digest") @db.Char(64)
  previewRevision     Int                 @default(1) @map("preview_revision")
  status              String              @db.VarChar(20)
  rowCount            Int                 @map("row_count")
  errorCount          Int                 @map("error_count")
  fileErrors          Json                @default("[]") @map("file_errors") @db.JsonB
  createdByIdentityId String              @map("created_by_identity_id") @db.Uuid
  reason              String              @db.VarChar(240)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy           Identity            @relation("EmployeeImportCreatedBy", fields: [createdByIdentityId], references: [id], onDelete: Restrict)
  rows                EmployeeImportRow[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestKey])
  @@index([tenantId, createdAt])
  @@map("employee_import_batches")
}

model EmployeeImportRow {
  id               String              @id @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  batchId          String              @map("batch_id") @db.Uuid
  rowNumber        Int                 @map("row_number")
  normalizedValues Json                @map("normalized_values") @db.JsonB
  errors           Json                @default("[]") @db.JsonB
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch            EmployeeImportBatch @relation(fields: [tenantId, batchId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, batchId, rowNumber])
  @@map("employee_import_rows")
}

model EmployeeAssignment {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  employmentPeriodId String          @map("employment_period_id") @db.Uuid
  branchId          String           @map("branch_id") @db.Uuid
  departmentId      String           @map("department_id") @db.Uuid
  designationId     String           @map("designation_id") @db.Uuid
  managerEmployeeId String?          @map("manager_employee_id") @db.Uuid
  topLevelReason    String?          @map("top_level_reason") @db.VarChar(240)
  effectiveFrom     DateTime         @map("effective_from") @db.Date
  effectiveTo       DateTime?        @map("effective_to") @db.Date
  createdByIdentityId String         @map("created_by_identity_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee          Employee         @relation("AssignedEmployee", fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  employmentPeriod  EmploymentPeriod @relation(fields: [tenantId, employmentPeriodId, employeeId], references: [tenantId, id, employeeId], onDelete: Restrict)
  branch            Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  department        Department       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  designation       Designation      @relation(fields: [tenantId, designationId], references: [tenantId, id], onDelete: Restrict)
  manager           Employee?        @relation("AssignmentManager", fields: [tenantId, managerEmployeeId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, managerEmployeeId, effectiveFrom])
  @@map("employee_assignments")
}

model EmployeeAccountRequest {
  id                    String              @id @db.Uuid
  requestKey            String              @map("request_key") @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  employeeId            String              @map("employee_id") @db.Uuid
  requestedByIdentityId String              @map("requested_by_identity_id") @db.Uuid
  email                 String              @db.VarChar(320)
  status                String              @default("pending_identity_provider") @db.VarChar(40)
  version               Int                 @default(1)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee              Employee            @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  requestedBy           Identity            @relation(fields: [requestedByIdentityId], references: [id], onDelete: Restrict)
  invitation            EmployeeInvitation?

  @@unique([tenantId, requestKey])
  @@unique([tenantId, employeeId])
  @@map("employee_account_requests")
}

model EmployeeInvitation {
  id                   String                 @id @db.Uuid
  requestId            String                 @unique @map("request_id") @db.Uuid
  tenantId             String                 @map("tenant_id") @db.Uuid
  employeeId           String                 @map("employee_id") @db.Uuid
  identityId           String                 @map("identity_id") @db.Uuid
  status               String                 @default("pending_delivery") @db.VarChar(30)
  expiresAt            DateTime               @map("expires_at") @db.Timestamptz()
  deliveredAt          DateTime?              @map("delivered_at") @db.Timestamptz()
  acceptedAt           DateTime?              @map("accepted_at") @db.Timestamptz()
  version              Int                    @default(1)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  request              EmployeeAccountRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee             Employee               @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  identity             Identity               @relation(fields: [identityId], references: [id], onDelete: Restrict)
  employeeIdentityLink EmployeeIdentityLink?

  @@unique([tenantId, employeeId])
  @@unique([tenantId, identityId])
  @@index([status, expiresAt])
  @@map("employee_invitations")
}

model EmployeeIdentityLink {
  id           String             @id @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  employeeId   String             @map("employee_id") @db.Uuid
  identityId   String             @map("identity_id") @db.Uuid
  membershipId String             @unique @map("membership_id") @db.Uuid
  invitationId String             @unique @map("invitation_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee     Employee           @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict)
  identity     Identity           @relation(fields: [identityId], references: [id], onDelete: Restrict)
  membership   Membership         @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  invitation   EmployeeInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId])
  @@unique([tenantId, identityId])
  @@unique([tenantId, membershipId])
  @@map("employee_identity_links")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  reason     String?  @db.VarChar(240)
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  type             String           @db.VarChar(100)
  aggregateId      String           @map("aggregate_id") @db.Uuid
  aggregateVersion Int              @map("aggregate_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  delivery         JobDelivery?
  receipt          ConsumerReceipt?

  @@unique([tenantId, id])
  @@unique([tenantId, aggregateId, aggregateVersion, type])
  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

model JobDelivery {
  eventId     String      @id @map("event_id") @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  status      String      @default("pending") @db.VarChar(20)
  attempts    Int         @default(0)
  availableAt DateTime    @default(now()) @map("available_at") @db.Timestamptz()
  lastError   String?     @map("last_error") @db.VarChar(60)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz()
  event       OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@map("job_deliveries")
}

model ConsumerReceipt {
  eventId     String      @id @map("event_id") @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  consumer    String      @db.VarChar(100)
  processedAt DateTime    @default(now()) @map("processed_at") @db.Timestamptz()
  event       OutboxEvent @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@map("consumer_receipts")
}
