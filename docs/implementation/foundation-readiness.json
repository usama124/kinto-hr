        "docs/implementation/DECISIONS.md"
      ]
    },
    {
      "id": "payroll_review",
      "owner": "Employer and Pakistan payroll specialist",
      "status": "review_required",
      "requiredEvidence": "Approve independently calculated fixtures and applicable effective statutory/employer rules before real payroll.",
