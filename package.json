{
  "name": "kinto-hr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @kinto/api --filter @kinto/web dev",
    "build": "pnpm --filter @kinto/api build && pnpm --filter @kinto/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && pnpm --filter @kinto/web typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @kinto/database generate",
    "db:migrate": "pnpm --filter @kinto/database migrate",
    "db:bootstrap": "tsx scripts/bootstrap-database.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm check:docs",
    "verify:full": "pnpm verify && pnpm test:integration && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@kinto/contracts": "workspace:*",
    "@kinto/database": "workspace:*",
    "@kinto/domain": "workspace:*",
    "@nestjs/testing": "12.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.12.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
